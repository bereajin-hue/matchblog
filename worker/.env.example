# 워커 인증 시크릿 (web과 동일한 값, 절대 평문 코드에 하드코딩 금지)
WORKER_SECRET=

# Supabase (service_role — 워커 전용, 외부 노출 금지)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 자격증명 암호화 마스터키 (DB·web과 분리 보관, 유출 시 즉시 교체)
CREDENTIAL_MASTER_KEY=

# 네이버 블로그 계정 (AES-256-GCM 복호화 후 메모리에서만 사용, 로그 출력 금지)
NAVER_BLOG_ID_1=
NAVER_BLOG_PW_1=
NAVER_BLOG_ID_2=
NAVER_BLOG_PW_2=
NAVER_BLOG_ID_3=
NAVER_BLOG_PW_3=
NAVER_BLOG_ID_4=
NAVER_BLOG_PW_4=
NAVER_BLOG_ID_5=
NAVER_BLOG_PW_5=
NAVER_BLOG_ID_6=
NAVER_BLOG_PW_6=
NAVER_BLOG_ID_7=
NAVER_BLOG_PW_7=

# 티스토리 OAuth Access Token (암호화 저장)
TISTORY_ACCESS_TOKEN_1=
TISTORY_ACCESS_TOKEN_2=
TISTORY_ACCESS_TOKEN_3=

# Blogger (Google OAuth2, 암호화 저장)
BLOGGER_ACCESS_TOKEN=
BLOGGER_BLOG_ID=

# Gemini Vision API (플레이스 분석용)
GEMINI_API_KEY=
